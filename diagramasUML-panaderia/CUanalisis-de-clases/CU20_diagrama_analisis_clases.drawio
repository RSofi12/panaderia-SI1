          <mxGeometry x="-0.6" relative="1" as="geometry"><mxPoint x="14" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="cu20a-r-user-mov-t" value="+0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="cu20a-r-user-mov">
          <mxGeometry x="0.6" relative="1" as="geometry"><mxPoint x="18" as="offset" /></mxGeometry>
