        <mxCell id="cu20a-e-actor-ui" edge="1" parent="1" source="cu20a-actor" target="cu20a-ui" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;">
          <mxGeometry relative="1" as="geometry" />
