        <mxCell id="titulo" value="CU21. Generar reporte de ventas — Diagrama de comunicación" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
