@startuml panaderia_santiago

title DIAGRAMA DE CLASES\nSISTEMA DE INFORMACIÓN WEB - PANADERÍA SANTIAGO

left to right direction

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 70

skinparam class {
    BorderColor #444444
    ArrowColor #555555
    FontColor #222222
    AttributeFontColor #333333
}


' =========================================================
' USUARIOS Y SEGURIDAD (CU01 - CU04, CU26)
' =========================================================

class Rol #D9EAF7 {
    -idRol : int
    -nombre : String
    -descripcion : String
    +asignarPermiso()
    +quitarPermiso()
}

class Permiso #D9EAF7 {
    -idPermiso : int
    -nombre : String
    -descripcion : String
    -modulo : String
}

class RolPermiso #D9EAF7 {
    -id : int
    -idRol : int
    -idPermiso : int
}

class Usuario #D9EAF7 {
    -idUsuario : int
    -nombreUsuario : String
    -hashContrasena : String
    -nombreCompleto : String
    -email : String
    -activo : boolean
    -isStaff : boolean
    -isSuperuser : boolean
    -lastLogin : DateTime
    -intentosFallidos : int
    -bloqueadoHasta : DateTime
    -ultimoIntentoFallido : DateTime
    +registrar()
    +editar()
    +activar()
    +inactivar()
    +iniciarSesion()
    +cerrarSesion()
    +validarFormatoContrasena()
    +cambiarContrasena()
    +desbloquear()
    +solicitarRecuperacion()
    +restablecerContrasena()
}

class Bitacora #D9EAF7 {
    -idBitacora : int
    -nombreUsuarioIntento : String
    -agenteUsuario : String
    -accion : String
    -tablaAfectada : String
    -descripcion : String
    -fechaHora : DateTime
    +registrarAccion()
}

class ConfiguracionSeguridad #D9EAF7 {
    -idConfiguracion : int
    -maxIntentosFallidos : int
    -minutosBloqueo : int
    -minutosExpiracionToken : int
    -maxIntentosToken : int
    -maxSolicitudesPorHora : int
    -actualizadoEn : DateTime
    +actualizarParametros()
    +obtenerConfiguracion()
}

class TokenRecuperacion #D9EAF7 {
    -idToken : int
    -tokenHash : String
    -emailDestino : String
    -creadoEn : DateTime
    -expiraEn : DateTime
    -usadoEn : DateTime
    -invalidadoEn : DateTime
    -intentos : int
    -ipOrigen : String
    -agenteUsuario : String
    +generarToken()
    +validarToken()
    +marcarUsado()
    +invalidar()
}


' =========================================================
' PRODUCTOS (CU05, CU19)
' =========================================================

class CategoriaProducto #FFF2CC {
    -idCategoria : int
    -nombre : String
    -descripcion : String
    +registrar()
    +editar()
}

class Producto #FFF2CC {
    -idProducto : int
    -nombre : String
    -descripcion : String
    -costoProduccion : decimal
    -porcentajeGanancia : decimal
    -precioSugerido : decimal
    -precioVenta : decimal
    -fechaRegistro : DateTime
    -activo : boolean
    +registrar()
    +editar()
    +consultar()
    +inactivar()
    +calcularCostoProduccion()
    +calcularPrecioSugerido()
    +actualizarPrecioVenta()
}

class ProductoMateriaPrima #FFF2CC {
    -cantidadRequerida : decimal
    -unidadMedida : String
    +actualizarCantidad()
    +calcularConsumo()
}

class HistorialPrecioProducto #FFF2CC {
    -idHistorial : int
    -precio : decimal
    -fechaInicio : DateTime
    +registrarPrecio()
}


' =========================================================
' PRODUCCIÓN (CU10, CU11)
' =========================================================

class Produccion #D5E8D4 {
    -idProduccion : int
    -fecha : Date
    -jornada : String
    +registrar()
    +confirmar()
}

class DetalleProduccion #D5E8D4 {
    -idDetalleProduccion : int
    -cantidadProducida : int
    -costoUnitario : decimal
    +registrarCantidad()
    +calcularCosto()
}


' =========================================================
' INVENTARIO DE MATERIA PRIMA (CU08, CU09)
' =========================================================

class MateriaPrima #F8CECC {
    -idMateriaPrima : int
    -nombre : String
    -unidadMedida : String
    -stockMinimo : decimal
    -fechaRegistro : DateTime
    -activo : boolean
    +registrar()
    +editar()
    +inactivar()
    +consultar()
}

class HistorialPrecioMateriaPrima #F8CECC {
    -idHistorial : int
    -precio : decimal
    -fechaInicio : DateTime
    +registrarPrecio()
}

class InventarioMateriaPrima #F8CECC {
    -idInventario : int
    -stockActual : decimal
    +registrarEntrada()
    +registrarSalida()
    +consultarStock()
    +verificarStockMinimo()
}

class MovimientoMateriaPrima #F8CECC {
    -idMovimiento : int
    -fechaHora : DateTime
    -tipo : String
    -cantidad : decimal
    +registrar()
}


' =========================================================
' INVENTARIO DE PRODUCTOS TERMINADOS Y MERMAS (CU12, CU18)
' =========================================================

class InventarioProductoTerminado #E1D5E7 {
    -idInventario : int
    -stockActual : int
    +registrarEntrada()
    +registrarSalida()
    +consultarDisponibilidad()
}

class MovimientoProductoTerminado #E1D5E7 {
    -idMovimiento : int
    -fechaHora : DateTime
    -tipo : String
    -cantidad : int
    +registrar()
}

class NotaPerdidaProducto #E1D5E7 {
    -idNotaPerdida : int
    -cantidad : int
    -costoUnitario : decimal
    -fechaSalida : DateTime
    +registrarMerma()
    +calcularCostoPerdida()
}


' =========================================================
' COMPRAS, PROVEEDORES Y GASTOS (CU06, CU07, CU20)
' =========================================================

class Proveedor #FFE6CC {
    -idProveedor : int
    -nombre : String
    -telefono : String
    -direccion : String
    -fechaRegistro : DateTime
    -activo : boolean
    +registrar()
    +editar()
    +inactivar()
    +consultar()
}

class Compra #FFE6CC {
    -idCompra : int
    -fechaHora : DateTime
    -total : decimal
    +registrar()
    +calcularTotal()
    +confirmar()
}

class DetalleCompra #FFE6CC {
    -idDetalleCompra : int
    -cantidad : decimal
    -precioUnitario : decimal
    -subtotal : decimal
    +calcularSubtotal()
}

class MovimientoEconomico #FFE6CC {
    -idMovimiento : int
    -tipo : String
    -concepto : String
    -descripcion : String
    -monto : decimal
    -fechaHora : DateTime
    +registrar()
    +editar()
}


' =========================================================
' COMERCIALIZACIÓN (CU13 - CU17)
' =========================================================

class Cliente #D5E8D4 {
    -idCliente : int
    -nombre : String
    -telefono : String
    -direccion : String
    +registrar()
    +editar()
}

class Pedido #D5E8D4 {
    -idPedido : int
    -fechaRegistro : DateTime
    -fechaEntrega : DateTime
    -estado : String
    -metodoPago : String
    -total : decimal
    +registrar()
    +calcularTotal()
    +cambiarEstado()
    +entregar()
}

class DetallePedido #D5E8D4 {
    -idDetallePedido : int
    -cantidad : int
    -precioUnitario : decimal
    -subtotal : decimal
    +calcularSubtotal()
}

class Venta #D5E8D4 {
    -idVenta : int
    -numeroComprobante : int
    -fechaHora : DateTime
    -metodoPago : String
    -idTransaccionStripe : String
    -total : decimal
    +registrar()
    +calcularTotal()
    +confirmar()
    +generarComprobante()
}

class DetalleVenta #D5E8D4 {
    -idDetalleVenta : int
    -cantidad : int
    -precioUnitario : decimal
    -subtotal : decimal
    +calcularSubtotal()
}


' =========================================================
' RELACIONES - SEGURIDAD
' =========================================================

Rol "1" -- "0..*" Usuario : tiene >
Rol "1" -- "0..*" RolPermiso : asigna >
Permiso "1" -- "0..*" RolPermiso : asocia >
Usuario "1" -- "0..*" Bitacora : registra >
Usuario "0..1" -- "0..*" ConfiguracionSeguridad : actualiza >
Usuario "1" -- "0..*" TokenRecuperacion : solicita >


' =========================================================
' RELACIONES - PRODUCTOS
' =========================================================

CategoriaProducto "1" -- "0..*" Producto : clasifica >

Producto "1" -- "0..*" ProductoMateriaPrima : requiere >
MateriaPrima "1" -- "0..*" ProductoMateriaPrima : compone >

MateriaPrima "1" -- "0..*" HistorialPrecioMateriaPrima : registra historial de >
Producto "1" -- "0..*" HistorialPrecioProducto : registra historial de >


' =========================================================
' RELACIONES - PRODUCCIÓN
' =========================================================

Usuario "1" -- "0..*" Produccion : realiza >

Produccion "1" *-- "1..*" DetalleProduccion : detalla >
Producto "1" -- "0..*" DetalleProduccion : referencia >


' =========================================================
' RELACIONES - INVENTARIO MATERIA PRIMA
' =========================================================

MateriaPrima "1" -- "1" InventarioMateriaPrima : tiene >

InventarioMateriaPrima "1" *-- "0..*" MovimientoMateriaPrima : genera >

Compra "0..1" -- "0..*" MovimientoMateriaPrima : origina >
Produccion "0..1" -- "0..*" MovimientoMateriaPrima : consume >


' =========================================================
' RELACIONES - INVENTARIO PRODUCTO TERMINADO Y MERMAS
' =========================================================

Producto "1" -- "1" InventarioProductoTerminado : tiene >

InventarioProductoTerminado "1" *-- "0..*" MovimientoProductoTerminado : genera >

Produccion "0..1" -- "0..*" MovimientoProductoTerminado : incrementa >
Venta "0..1" -- "0..*" MovimientoProductoTerminado : reduce >
Pedido "0..1" -- "0..*" MovimientoProductoTerminado : reduce >
NotaPerdidaProducto "0..1" -- "0..1" MovimientoProductoTerminado : origina >

DetalleProduccion "1" -- "0..*" NotaPerdidaProducto : genera >
Usuario "1" -- "0..*" NotaPerdidaProducto : registra >


' =========================================================
' RELACIONES - COMPRAS
' =========================================================

Proveedor "1" -- "0..*" Compra : provee >
Usuario "1" -- "0..*" Compra : registra >

Compra "1" *-- "1..*" DetalleCompra : detalla >
MateriaPrima "1" -- "0..*" DetalleCompra : incluye >


' =========================================================
' RELACIONES - GASTOS E INVERSIONES
' =========================================================

Usuario "1" -- "0..*" MovimientoEconomico : registra >


' =========================================================
' RELACIONES - PEDIDOS
' =========================================================

Cliente "1" -- "0..*" Pedido : realiza >
Usuario "1" -- "0..*" Pedido : atiende >

Pedido "1" *-- "1..*" DetallePedido : contiene >
Producto "1" -- "0..*" DetallePedido : incluye >

Pedido "0..1" -- "0..1" Venta : genera >


' =========================================================
' RELACIONES - VENTAS
' =========================================================

Usuario "1" -- "0..*" Venta : registra >

Venta "1" *-- "1..*" DetalleVenta : contiene >
Producto "1" -- "0..*" DetalleVenta : incluye >


' =========================================================
' ORGANIZACIÓN VISUAL
' =========================================================

Rol -[hidden]down-> Permiso
Permiso -[hidden]down-> RolPermiso
Usuario -[hidden]down-> Bitacora
Bitacora -[hidden]down-> ConfiguracionSeguridad
ConfiguracionSeguridad -[hidden]down-> TokenRecuperacion

CategoriaProducto -[hidden]down-> Producto

Cliente -[hidden]down-> Pedido
Pedido -[hidden]down-> DetallePedido

Venta -[hidden]down-> DetalleVenta

Produccion -[hidden]down-> DetalleProduccion

Producto -[hidden]down-> ProductoMateriaPrima
ProductoMateriaPrima -[hidden]down-> MateriaPrima

MateriaPrima -[hidden]down-> HistorialPrecioMateriaPrima
HistorialPrecioMateriaPrima -[hidden]down-> InventarioMateriaPrima
InventarioMateriaPrima -[hidden]down-> MovimientoMateriaPrima

Producto -[hidden]down-> InventarioProductoTerminado
InventarioProductoTerminado -[hidden]down-> MovimientoProductoTerminado
MovimientoProductoTerminado -[hidden]down-> NotaPerdidaProducto

Proveedor -[hidden]down-> Compra
Compra -[hidden]down-> DetalleCompra

@enduml
