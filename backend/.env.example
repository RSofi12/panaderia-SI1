# ==================================================================
# BASE DE DATOS (PostgreSQL)
# ==================================================================
DB_NAME=panaderia_db
DB_USER=panaderia_admin
DB_PASSWORD=tu_contrasena_real
DB_HOST=localhost
DB_PORT=5432

# ==================================================================
# SEGURIDAD DEL PROYECTO
# Copiá SECRET_KEY desde `python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"`
# ==================================================================
SECRET_KEY=cambiala_en_produccion
DEBUG=True

# ==================================================================
# CORREO (CU2 — Recuperar contraseña)
# ==================================================================
# Desarrollo: el backend `smtp` habla con Mailpit, que captura todo el correo y
# lo muestra en el navegador. No envía nada a internet.
#
# Mailpit NO se instala con pip. Es un binario aparte:
#   - Windows: descargalo de https://github.com/axllent/mailpit/releases
#   - scoop install mailpit   /   winget install mailpit
#   - o corre el Docker: docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#
# Si NO querés instalar nada, comentá EMAIL_BACKEND y DÉJALO con el valor por
# defecto: Django imprimirá el correo en la terminal del manage.py runserver.
# ==================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@panaderiasantiago.com

# ==================================================================
# ENLACE DE RECUPERACIÓN (CU2)
# Ruta del FRONTEND donde se escribe la contraseña nueva. El token se le
# agrega solo como parámetro ?token=...; no la escribas acá.
# ==================================================================
PASSWORD_RESET_URL=http://localhost:5173/recuperar-password/nueva
