## ==================================================================
# SEGURIDAD DE DJANGO
# Generá una clave segura con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# En producción (Railway) esta variable es OBLIGATORIA. El default del código
# es inseguro y está marcado como "django-insecure-...".
# ==================================================================
SECRET_KEY=cambiala_en_produccion
DEBUG=True

# ==================================================================
# BASE DE DATOS (PostgreSQL)
# En Railway: conectar el servicio PostgreSQL genera DATABASE_URL automáticamente.
# En local: usar las variables individuales DB_*.
# El settings.py lee DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT.
# Para apuntar a SQLite en tests locales: DB_ENGINE=django.db.backends.sqlite3
# ==================================================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=panaderia_db
DB_USER=panaderia_admin
DB_PASSWORD=tu_contrasena_real
DB_HOST=localhost
DB_PORT=5432

# ==================================================================
# CORS — orígenes permitidos para llamadas desde el frontend
# En producción agregar la URL de Vercel:
#   https://panaderia-si1.vercel.app
# El settings.py tiene una lista fija; si se necesita hacerla dinámica
# se puede leer desde acá con config('CORS_ALLOWED_ORIGINS').
# ==================================================================
# (actualmente hardcodeado en settings.py — ver CORS_ALLOWED_ORIGINS)

# ==================================================================
# CORREO (CU2 — Recuperar contraseña)
# ------------------------------------------------------------------
# DESARROLLO (Mailpit — captura correos sin enviarlos a nadie):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=localhost
#   EMAIL_PORT=1025
#   EMAIL_USE_TLS=False
#   Ver correos en http://localhost:8025
#
# RAILWAY / DEMO (sin SMTP — el link aparece en los logs de Railway):
#   Omitir EMAIL_BACKEND o dejarlo vacío.
#   El default del settings.py es console.EmailBackend, que imprime
#   el correo en stdout → visible en Logs del Web Service de Railway.
#
# PRODUCCIÓN REAL (Resend, Gmail, SendGrid, etc.):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.resend.com           # o smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=resend               # o tu correo Gmail
#   EMAIL_HOST_PASSWORD=re_xxxxxxxxxx    # API key o contraseña de app
#   EMAIL_USE_TLS=True
# ==================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@panaderiasantiago.com

# ==================================================================
# ENLACE DE RECUPERACIÓN (CU2)
# URL del frontend donde el usuario escribe la contraseña nueva.
# En Railway/Vercel: reemplazar localhost por la URL real del frontend.
#   Ejemplo: https://panaderia-si1.vercel.app/recuperar-password/nueva
# ==================================================================
PASSWORD_RESET_URL=http://localhost:5173/recuperar-password/nueva

# ==================================================================
# STRIPE (CU13 — venta con tarjeta)
# Claves de prueba desde https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY  → clave secreta (sk_test_...) solo para el backend.
# STRIPE_PUBLISHABLE_KEY → clave pública (pk_test_...) para el frontend.
# STRIPE_CURRENCY    → moneda ISO 4217 (bob = boliviano, usd = dólar).
# ==================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=bob

